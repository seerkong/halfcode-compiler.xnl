  run_object_operation,
} from "./<%= references.objectArtifacts.bundlePath %>"

const output = await run_object_operation({
  targets: {
    kind: "single",
    ref: { kindFqn: "Demo.ResourceWorkflow.BO.MakerSpace.Reservation", key: { reservationNumber: "R-100" } },
  },
  invocation: {
    kind: "action",
    operationRef: "Demo.ResourceWorkflow.BO.MakerSpace.Reservation.approve",
    input: { approvedBy: "M-7" },
  },
  config: { trace: true },
})
```

Use `invocation.input` for action business input and `invocation.desired` for
mutation desired state. The host initializes runtime; AI-authored code never
passes runtime.
