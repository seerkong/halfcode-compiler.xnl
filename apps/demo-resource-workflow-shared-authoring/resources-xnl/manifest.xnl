<ResourcePackage #Demo.ResourceWorkflow.Shared.Authoring envelopeVersion="halfcode.resource-envelope/v1" specVersion=1 {
  lifecycle = "Active"
  description = "XNL-native shared authoring resources for the demo workflow."
} (
  <Catalogs [
    <Catalog #KindDefinitions { kind = "KindDefinition" shape = "directory" root = "vfs://./KindDefinitions/" entry = "manifest.xnl" }>
    <Catalog #PromptFragments { kind = "PromptFragment" shape = "directory" root = "vfs://./PromptFragments/" entry = "manifest.xnl" }>
  ]>
)>
