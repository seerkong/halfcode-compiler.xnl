<OperationHooks #codument.config.operation_hooks apiVersion="codument.tech/v1alpha1" version="1" (
  <Operations [
    <Operation #archive-track (
      <Hooks [
        <Hook { on = "archive-track:after" } (
          <ArtifactSync { use = "docs" }>
        )>
      ]>
    )>
    <Operation #gap-loop (
      <GapLoopDefaults { verify_round = false }>
    )>
  ]>
)>
