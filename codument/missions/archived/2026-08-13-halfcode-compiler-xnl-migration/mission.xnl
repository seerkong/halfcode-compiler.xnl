<Mission #halfcode-compiler-xnl-migration version="1" apiVersion="codument.tech/v1alpha1" { status = "completed" goal = "将 halfcode resource compiler 从 XML authoring、解析与发布边界迁移为 XNL-native DSL 和 halfcode-compiler.xnl 产品。" description = "以 xnl-core 能力和 depa-flows 的 XNL DSL 规范习惯为约束，分 tracks 收敛语言契约、compiler core、consumers、资源树、文档与 distribution。" question_mode = "decision-tree" question_severity = "auto" revision = 16 created_at = "2026-08-12T16:30:11Z" updated_at = "2026-08-13T03:14:13Z" } (
