<Track #expose-loader-content-identities-and-prepare-0-2-2 apiVersion="codument.tech/v1alpha1" version="1" {
  status = "completed"
  goal = "让 Halfcode loader 公开 snapshot-ready content identities，并把 additive resource API 准备为不可变 0.2.2 candidate。"
  description = "单次 raw-byte identity、authentic effective identity projection、legacy compatibility 与 packed 0.2.2 consumer verification；不执行外部发布。"
  question_mode = "decision-tree"
  question_severity = "auto"
  commit_mode = "manual"
  created_at = "2026-08-15T20:44:04Z"
  updated_at = "2026-08-15T21:30:29Z"
