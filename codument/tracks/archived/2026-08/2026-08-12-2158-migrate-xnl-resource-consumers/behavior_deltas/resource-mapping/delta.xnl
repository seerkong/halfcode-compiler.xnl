<BehaviorPatch #track.r_2_0_2_6_-_0_8_-_1_2_-_2_1_5_8_-_m_i_g_r_a_t_e_-_x_n_l_-_r_e_s_o_u_r_c_e_-_c_o_n_s_u_m_e_r_s.behavior_patch.resource-mapping apiVersion="codument.tech/v1alpha1" version="1" { capability = "resource-mapping" } (
  <Mutations [
    <Upsert { selector = "behavior://resource-mapping/requirements/xnl-mappings" } (
      <Requirement #xnl-mappings (
        <Statement ?01M0TB1VF7YQWQ1M7P9MCD51WT>
        系统 SHALL 使用 XNL ResourceMappings 表达 reference targets、callable target、source roots 与 copy operations，并保持 collision/containment preflight。
        </?01M0TB1VF7YQWQ1M7P9MCD51WT>
        <Suites [
          <Suite #mapping (
            <Cases [
              <Case #parse-plan-apply (
                <Given ?01M0TB1VF7YQWQ1M7P9MCD51WV>
                有效 XNL ResourceMappings 与命名 module roots
                </?01M0TB1VF7YQWQ1M7P9MCD51WV>
                <When ?01M0TB1VF7YQWQ1M7P9MCD51WW>
                parse、plan、apply
                </?01M0TB1VF7YQWQ1M7P9MCD51WW>
                <Then ?01M0TB1VF7YQWQ1M7P9MCD51WX>
                复制结果 SHALL 确定且安全
                </?01M0TB1VF7YQWQ1M7P9MCD51WX>
              )>
              <Case #reject-invalid (
                <Given ?01M0TB1VF7YQWQ1M7P9MCD51WY>
                重复 id、危险路径或 target collision
                </?01M0TB1VF7YQWQ1M7P9MCD51WY>
                <When ?01M0TB1VF7YQWQ1M7P9MCD51WZ>
                解析或规划
                </?01M0TB1VF7YQWQ1M7P9MCD51WZ>
                <Then ?01M0TB1VF7YQWQ1M7P9MCD51X0>
                系统 SHALL 在写入前拒绝
                </?01M0TB1VF7YQWQ1M7P9MCD51X0>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
