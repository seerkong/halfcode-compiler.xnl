<DecisionRegistry #track_migrate_authoring_trees_to_xnl apiVersion="codument/v1" lifecycle="Active" {
  description = "Track-local decisions for staged XNL authoring migration"
} (
  <Decisions [
    <Decision #parallel_xnl_authority status="accepted" {
      summary = "Stage complete generic XNL packages under resources-xnl before the final cutover"
      rationale = "The loader prefers manifest.xnl; co-locating an intentionally incomplete tree would hide deferred BO/PO resources."
      consequence = "G7 must cut over the staged tree only after BO/PO convergence."
    }>
  ]>
)>
