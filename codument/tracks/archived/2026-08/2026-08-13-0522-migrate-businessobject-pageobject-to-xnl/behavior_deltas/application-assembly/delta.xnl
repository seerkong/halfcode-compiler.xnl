<BehaviorPatch #track.r_2_0_2_6_-_0_8_-_1_3_-_0_5_2_2_-_m_i_g_r_a_t_e_-_b_u_s_i_n_e_s_s_o_b_j_e_c_t_-_p_a_g_e_o_b_j_e_c_t_-_t_o_-_x_n_l.behavior_patch.application-assembly apiVersion="codument.tech/v1alpha1" version="1" { capability = "application-assembly" } (
  <Mutations [
    <Upsert { selector = "behavior://application-assembly/requirements/xnl-generic-consumers" } (
      <Requirement #xnl-generic-consumers (
        <Statement ?01M0TB1VFBQGNAQJ1NQN6F3S3S>
        系统 SHALL 从 normalized ResourceNode 的 properties/body/subdomains 组装所有 XNL 资源，且 public assembly 不依赖 XmlObject/@attribute 私有形状。
        </?01M0TB1VFBQGNAQJ1NQN6F3S3S>
        <Suites [
          <Suite #xnl-consumers (
            <Cases [
              <Case #assemble-callable-text-skill (
                <Given ?01M0TB1VFBQGNAQJ1NQN6F3S3T>
                XNL package 含 callable、text 与 SkillCapsule resources
                </?01M0TB1VFBQGNAQJ1NQN6F3S3T>
                <When ?01M0TB1VFBQGNAQJ1NQN6F3S3V>
                application assembly 加载 package
                </?01M0TB1VFBQGNAQJ1NQN6F3S3V>
                <Then ?01M0TB1VFBQGNAQJ1NQN6F3S3W>
                contracts、code binding、materials、includes 与 provenance SHALL 正确投影
                </?01M0TB1VFBQGNAQJ1NQN6F3S3W>
              )>
              <Case #assemble-object-owners (
                <Given ?01M0TB1VFBQGNAQJ1NQN6F3S3X>
                XNL package 含 BusinessObject、PageObject 与 operation handler resources
                </?01M0TB1VFBQGNAQJ1NQN6F3S3X>
                <When ?01M0TB1VFBQGNAQJ1NQN6F3S3Y>
                application assembly 加载 package
                </?01M0TB1VFBQGNAQJ1NQN6F3S3Y>
                <Then ?01M0TB1VFBQGNAQJ1NQN6F3S3Z>
                系统 SHALL 投影统一 target/operation catalog 并验证 private binding closure
                </?01M0TB1VFBQGNAQJ1NQN6F3S3Z>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
