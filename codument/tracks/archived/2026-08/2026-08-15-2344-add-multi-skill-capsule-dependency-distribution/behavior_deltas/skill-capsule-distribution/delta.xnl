<BehaviorPatch #track.r_2_0_2_6_-_0_8_-_1_5_-_2_3_4_4_-_a_d_d_-_m_u_l_t_i_-_s_k_i_l_l_-_c_a_p_s_u_l_e_-_d_e_p_e_n_d_e_n_c_y_-_d_i_s_t_r_i_b_u_t_i_o_n.behavior_patch.skill-capsule-distribution apiVersion="codument.tech/v1alpha1" version="1" { capability = "skill-capsule-distribution" } (
  <Mutations [
    <Upsert { selector = "behavior://skill-capsule-distribution/requirements/version-authority" } (
      <Requirement #version-authority (
        <Statement ?01M0TB1VFX2PVQE83TQ1J5NMZH>
        系统 SHALL 以 SkillCapsule XNL root metadata version 作为 capsule 的唯一版本 authority，并 SHALL 拒绝与之冲突的 YAML version。
        </?01M0TB1VFX2PVQE83TQ1J5NMZH>
        <Suites [
          <Suite #version-projection { name = "版本投影" } (
            <Cases [
              <Case #accept-omitted-yaml-version (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NMZJ>
                SkillCapsule XNL 声明 version 且 SKILL.metadata.yaml 未声明 version
                </?01M0TB1VFX2PVQE83TQ1J5NMZJ>
                <When ?01M0TB1VFX2PVQE83TQ1J5NMZK>
                application assembly 投影该 SkillCapsule
                </?01M0TB1VFX2PVQE83TQ1J5NMZK>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NMZM>
                投影 SHALL 使用 XNL version，并 SHALL NOT 制造第二份 YAML authority
                </?01M0TB1VFX2PVQE83TQ1J5NMZM>
              )>
              <Case #accept-matching-yaml-version (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NMZN>
                XNL version 与 YAML version 完全相同
                </?01M0TB1VFX2PVQE83TQ1J5NMZN>
                <When ?01M0TB1VFX2PVQE83TQ1J5NMZP>
                application assembly 投影 Skill metadata
                </?01M0TB1VFX2PVQE83TQ1J5NMZP>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NMZQ>
                系统 SHALL 接受资源并把 canonical XNL version 暴露给 compiler
                </?01M0TB1VFX2PVQE83TQ1J5NMZQ>
              )>
              <Case #reject-conflicting-yaml-version (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NMZR>
                XNL version 与 YAML version 不同
                </?01M0TB1VFX2PVQE83TQ1J5NMZR>
                <When ?01M0TB1VFX2PVQE83TQ1J5NMZS>
                application assembly 加载 SkillCapsule
                </?01M0TB1VFX2PVQE83TQ1J5NMZS>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NMZT>
                系统 SHALL 在 compiler 写入前返回稳定 version conflict diagnostic
                </?01M0TB1VFX2PVQE83TQ1J5NMZT>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://skill-capsule-distribution/requirements/sibling-dependency-closure" } (
      <Requirement #sibling-dependency-closure (
        <Statement ?01M0TB1VFX2PVQE83TQ1J5NMZV>
        系统 SHALL 使用显式 SkillDependencies 解析 sibling SkillCapsule 的精确版本依赖，并 SHALL 生成无缺失、无环且稳定的传递闭包拓扑。
        </?01M0TB1VFX2PVQE83TQ1J5NMZV>
        <Suites [
          <Suite #dependency-resolution { name = "依赖解析" } (
            <Cases [
              <Case #resolve-transitive-shared-dependencies (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NMZW>
                多个 root Skill 通过 resource ref 共享传递 sibling dependencies
                </?01M0TB1VFX2PVQE83TQ1J5NMZW>
                <When ?01M0TB1VFX2PVQE83TQ1J5NMZX>
                planner 解析完整 closure
                </?01M0TB1VFX2PVQE83TQ1J5NMZX>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NMZY>
                每个 Skill SHALL 只出现一次，dependency SHALL 先于 dependent，ready tie SHALL 按 FQN 稳定排序
                </?01M0TB1VFX2PVQE83TQ1J5NMZY>
              )>
              <Case #reject-missing-or-wrong-kind (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NMZZ>
                SkillDependency 指向不存在资源或非 SkillCapsule resource
                </?01M0TB1VFX2PVQE83TQ1J5NMZZ>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN00>
                planner 构建 dependency graph
                </?01M0TB1VFX2PVQE83TQ1J5NN00>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN01>
                系统 SHALL 返回稳定 diagnostic 且 SHALL NOT 产生 distribution plan
                </?01M0TB1VFX2PVQE83TQ1J5NN01>
              )>
              <Case #reject-version-mismatch (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN02>
                SkillDependency exact version 与目标 SkillCapsule XNL version 不同
                </?01M0TB1VFX2PVQE83TQ1J5NN02>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN03>
                planner 验证 dependency binding
                </?01M0TB1VFX2PVQE83TQ1J5NN03>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN04>
                系统 SHALL 拒绝闭包且 SHALL 报告 ref、expected version 与 actual version
                </?01M0TB1VFX2PVQE83TQ1J5NN04>
              )>
              <Case #reject-cycle (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN05>
                Skill dependency graph 含 self-cycle 或 multi-node cycle
                </?01M0TB1VFX2PVQE83TQ1J5NN05>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN06>
                planner 计算 topology
                </?01M0TB1VFX2PVQE83TQ1J5NN06>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN07>
                系统 SHALL 拒绝计划并 SHALL 返回规范化 cycle path
                </?01M0TB1VFX2PVQE83TQ1J5NN07>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://skill-capsule-distribution/requirements/deterministic-complete-plan" } (
      <Requirement #deterministic-complete-plan (
        <Statement ?01M0TB1VFX2PVQE83TQ1J5NN08>
        系统 SHALL 在零目标写入的 plan 阶段以不可变可序列化 authority 捕获完整 Skill closure 的所有输出 bytes、relative targets 与版本化 digests，并 SHALL 在返回计划前完成全闭包 collision preflight。
        </?01M0TB1VFX2PVQE83TQ1J5NN08>
        <Suites [
          <Suite #plan { name = "完整计划" } (
            <Cases [
              <Case #same-input-same-plan (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN09>
                assembly、root Skills、schemas 与 compiler options 语义相同，但资源枚举顺序或 schema plain-object key 插入顺序不同
                </?01M0TB1VFX2PVQE83TQ1J5NN09>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN0A>
                planner 分别生成 distribution plan
                </?01M0TB1VFX2PVQE83TQ1J5NN0A>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN0B>
                可序列化 plan、topology、file order、capsule digests 与 closure digest SHALL 完全相同
                </?01M0TB1VFX2PVQE83TQ1J5NN0B>
              )>
              <Case #plan-does-not-write (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN0C>
                caller 提供已存在的 live output root
                </?01M0TB1VFX2PVQE83TQ1J5NN0C>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN0D>
                planner 成功或因 dependency/schema/mapping 失败
                </?01M0TB1VFX2PVQE83TQ1J5NN0D>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN0E>
                live output root SHALL 保持逐字节不变
                </?01M0TB1VFX2PVQE83TQ1J5NN0E>
              )>
              <Case #reject-closure-collision-before-write (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN0F>
                任意两个 closure file claims 相同、按 path segment 前缀覆盖，或 mapping target 与 generated target 冲突；包括 lexical sibling 夹在 ancestor/descendant 之间的 a、a-b、a/b
                </?01M0TB1VFX2PVQE83TQ1J5NN0F>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN0G>
                planner 执行全闭包 preflight
                </?01M0TB1VFX2PVQE83TQ1J5NN0G>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN0H>
                系统 SHALL 以确定性的原始冲突 owners 与 targets 在任何 target/staging mutation 前拒绝，不得退化为 file-set error 或泄漏 EEXIST
                </?01M0TB1VFX2PVQE83TQ1J5NN0H>
              )>
              <Case #canonical-schema-json (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN0J>
                callable 与 object operation 的 input/output schemas 仅有 top-level/nested plain-object key 插入顺序不同，array 顺序相同
                </?01M0TB1VFX2PVQE83TQ1J5NN0J>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN0K>
                planner 生成 reference、callable registry、object registry 与 digests
                </?01M0TB1VFX2PVQE83TQ1J5NN0K>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN0M>
                系统 SHALL 对 object keys 使用固定 UTF-16 顺序并产生完全相同 bytes/projection/digests；array 顺序 SHALL 保留且其改变 SHALL 改变输出
                </?01M0TB1VFX2PVQE83TQ1J5NN0M>
              )>
              <Case #reject-non-json-schema (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN0N>
                被引用 schema 含 nested undefined、non-finite number、non-plain/accessor/symbol value、sparse/extra-property array 或 cycle
                </?01M0TB1VFX2PVQE83TQ1J5NN0N>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN0P>
                planner 在共享 schema reader boundary 建立 canonical JSON authority
                </?01M0TB1VFX2PVQE83TQ1J5NN0P>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN0Q>
                系统 SHALL 以稳定 SKILL_SCHEMA_INVALID 在任何 target mutation 前 fail closed，不得依赖 JSON.stringify 的丢弃、替换或原生异常语义
                </?01M0TB1VFX2PVQE83TQ1J5NN0Q>
              )>
              <Case #reject-unsafe-path-lexemes (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN0R>
                Skill output name、legacy reference、generated/mapping claim 或 planned relative target 含 unpaired UTF-16 high/low surrogate、NUL/C0/C1 control、output segment separator、encoded separator/control、dot segment、absolute/backslash/empty/segment-whitespace 等不安全 lexical fact
                </?01M0TB1VFX2PVQE83TQ1J5NN0R>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN0S>
                planner 或 legacy compiler 建立 output claims
                </?01M0TB1VFX2PVQE83TQ1J5NN0S>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN0T>
                系统 SHALL 复用单一明确 UTF-16 code-unit/code-point/segment contract，在任何 normalize/join/safeResolve/digest 与 output parent/staging/live mutation 前以对应稳定 Halfcode code 拒绝，保留 raw owner+target；不得把非法 raw authority 静默规范化为合法 target 或 U+FFFD，合法 paired surrogate/non-BMP/中文 Unicode SHALL 原样保留且 join 前后 identity 不变
                </?01M0TB1VFX2PVQE83TQ1J5NN0T>
              )>
              <Case #reject-present-invalid-yaml-name (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN0V>
                真实 XNL SkillCapsule 引用的 YAML name 字段显式存在，但值为 empty、whitespace、control、non-string 或其他 unsafe output segment
                </?01M0TB1VFX2PVQE83TQ1J5NN0V>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN0W>
                planner 解析 Skill output identity
                </?01M0TB1VFX2PVQE83TQ1J5NN0W>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN0X>
                系统 SHALL 以 SKILL_OUTPUT_NAME_INVALID 在任何 target mutation 前拒绝；只有字段完全 absent 才 MAY 使用 legacy FQN-last-segment fallback
                </?01M0TB1VFX2PVQE83TQ1J5NN0X>
              )>
              <Case #freeze-source-bytes (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN0Y>
                plan 已成功生成，之后 authoring source 发生变化
                </?01M0TB1VFX2PVQE83TQ1J5NN0Y>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN0Z>
                applier 使用既有 plan
                </?01M0TB1VFX2PVQE83TQ1J5NN0Z>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN10>
                applier SHALL 使用 plan 中冻结 bytes，不得重读变化后的 source
                </?01M0TB1VFX2PVQE83TQ1J5NN10>
              )>
              <Case #immutable-planned-content-authority (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN11>
                planner 已返回含 canonical base64 content authority 与 compatibility byte view 的 plan
                </?01M0TB1VFX2PVQE83TQ1J5NN11>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN12>
                caller 修改从 compatibility view 取得的 Uint8Array
                </?01M0TB1VFX2PVQE83TQ1J5NN12>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN13>
                可序列化 projection、content digest 与后续 apply bytes SHALL 保持不变
                </?01M0TB1VFX2PVQE83TQ1J5NN13>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://skill-capsule-distribution/requirements/atomic-group-apply" } (
      <Requirement #atomic-group-apply (
        <Statement ?01M0TB1VFX2PVQE83TQ1J5NN14>
        系统 SHALL 把完整 distribution plan 作为一个原子组应用到 caller-provided output root，并 SHALL 在 stage、readback 或 commit 失败时恢复上一完整 root。
        </?01M0TB1VFX2PVQE83TQ1J5NN14>
        <Suites [
          <Suite #apply { name = "成组应用" } (
            <Cases [
              <Case #install-complete-closure (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN15>
                有效 plan 含多个具有 dependency 的 SkillCapsules
                </?01M0TB1VFX2PVQE83TQ1J5NN15>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN16>
                applier 成功完成 stage、readback 与 commit
                </?01M0TB1VFX2PVQE83TQ1J5NN16>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN17>
                live root SHALL 包含 plan 声明的完整且仅此一套 files，并返回 matching closure digest receipt
                </?01M0TB1VFX2PVQE83TQ1J5NN17>
              )>
              <Case #reject-invalid-plan-before-live-mutation (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN18>
                plan format、relative path、canonical content、content digest 或 closure digest 被修改
                </?01M0TB1VFX2PVQE83TQ1J5NN18>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN19>
                applier 校验 plan
                </?01M0TB1VFX2PVQE83TQ1J5NN19>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN1A>
                系统 SHALL 在 live mutation 前拒绝，上一 root SHALL 保持不变
                </?01M0TB1VFX2PVQE83TQ1J5NN1A>
              )>
              <Case #reject-redigested-unsafe-plan-path (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN1B>
                caller 把 planned capsule/target relative path 改为含 NUL、其他 C0/C1 control 或 unpaired high/low surrogate，并重新计算 matching capsule 与 closure digests
                </?01M0TB1VFX2PVQE83TQ1J5NN1B>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN1C>
                applier revalidate plan
                </?01M0TB1VFX2PVQE83TQ1J5NN1C>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN1D>
                系统 SHALL 在创建 output root parent 或 staging 之前以 SKILL_PLAN_TARGET_INVALID 拒绝；诊断 SHALL 稳定保留 raw skillFqn owner、capsuleRelativePath 或 targetRelativePath field 名与 JSON-escaped raw target；旧 live text/binary bytes SHALL 不变且不得泄漏 Node path TypeError
                </?01M0TB1VFX2PVQE83TQ1J5NN1D>
              )>
              <Case #reject-incomplete-root-closure-before-live-mutation (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN1E>
                plan 声明空 roots，或含任意无法从 roots 沿显式 SkillDependencies 到达的 capsule，即使 caller 已重新计算 matching closure digest
                </?01M0TB1VFX2PVQE83TQ1J5NN1E>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN1F>
                applier 校验完整 plan graph
                </?01M0TB1VFX2PVQE83TQ1J5NN1F>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN1G>
                系统 SHALL fail closed 且上一 live root SHALL 保持逐字节不变
                </?01M0TB1VFX2PVQE83TQ1J5NN1G>
              )>
              <Case #reject-resigned-invalid-required-skill-entry (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN1H>
                任一 root 或 dependency capsule 的 files 为空，或 canonical root-level SKILL.md 缺失、重复、大小写错误、target 错误，且 caller 已重新计算 matching capsule/closure digests
                </?01M0TB1VFX2PVQE83TQ1J5NN1H>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN1J>
                applier 校验完整 plan 结构
                </?01M0TB1VFX2PVQE83TQ1J5NN1J>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN1K>
                系统 SHALL 在 content digest 与任何 output parent/staging/live mutation 前以 SKILL_PLAN_REQUIRED_FILE_INVALID 拒绝，上一 live text/binary bytes SHALL 不变且不得遗留 staging
                </?01M0TB1VFX2PVQE83TQ1J5NN1K>
              )>
              <Case #rollback-partial-commit (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN1M>
                live root 已有上一完整版本，commit 在 backup 后或 live rename 时失败
                </?01M0TB1VFX2PVQE83TQ1J5NN1M>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN1N>
                applier 执行 rollback
                </?01M0TB1VFX2PVQE83TQ1J5NN1N>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN1P>
                上一完整 root SHALL 恢复且 SHALL NOT 暴露新旧混合 files
                </?01M0TB1VFX2PVQE83TQ1J5NN1P>
              )>
              <Case #caller-owns-output-root (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN1Q>
                caller 选择任意合法 output root
                </?01M0TB1VFX2PVQE83TQ1J5NN1Q>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN1R>
                Halfcode 计划或应用 Skill distribution
                </?01M0TB1VFX2PVQE83TQ1J5NN1R>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN1S>
                Halfcode SHALL 只使用显式 root，不得推导 Eidolon、home、global 或 workspace 安装路径/policy
                </?01M0TB1VFX2PVQE83TQ1J5NN1S>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://skill-capsule-distribution/requirements/single-capsule-compatibility" } (
      <Requirement #single-capsule-compatibility (
        <Statement ?01M0TB1VFX2PVQE83TQ1J5NN1T>
        系统 SHALL 保持既有单 Skill capsule public compile APIs 的签名与外部结果，同时 MAY 在内部复用单 root distribution plan/apply。
        </?01M0TB1VFX2PVQE83TQ1J5NN1T>
        <Suites [
          <Suite #compatibility { name = "兼容性" } (
            <Cases [
              <Case #preserve-legacy-output (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN1V>
                现有 consumer 使用 compileSkillCapsule 或 compileResourceSkillCapsule
                </?01M0TB1VFX2PVQE83TQ1J5NN1V>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN1W>
                以原有输入编译单 capsule
                </?01M0TB1VFX2PVQE83TQ1J5NN1W>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN1X>
                返回 shape、Skill name、排序后的 file list 与生成制品 SHALL 与 characterization baseline 兼容
                </?01M0TB1VFX2PVQE83TQ1J5NN1X>
              )>
              <Case #preserve-preflight-old-output (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN1Y>
                单 capsule compile 的 dependency、schema 或 target preflight 失败且 outputDir 已有上一结果
                </?01M0TB1VFX2PVQE83TQ1J5NN1Y>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN1Z>
                legacy API 返回失败
                </?01M0TB1VFX2PVQE83TQ1J5NN1Z>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN20>
                上一 outputDir SHALL 保持不变
                </?01M0TB1VFX2PVQE83TQ1J5NN20>
              )>
              <Case #public-package-smoke (
                <Given ?01M0TB1VFX2PVQE83TQ1J5NN21>
                consumer 只安装 halfcode-compiler.xnl tarball
                </?01M0TB1VFX2PVQE83TQ1J5NN21>
                <When ?01M0TB1VFX2PVQE83TQ1J5NN22>
                运行 runtime/type imports
                </?01M0TB1VFX2PVQE83TQ1J5NN22>
                <Then ?01M0TB1VFX2PVQE83TQ1J5NN23>
                根入口和 skill-capsule subpath SHALL 同时提供 legacy 与 additive distribution API，且不得泄漏 private workspace specifier
                </?01M0TB1VFX2PVQE83TQ1J5NN23>
              )>
            ]>
          )>
        ]>
      )>
