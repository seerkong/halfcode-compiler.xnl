<component #resource_consumers.application_assembly apiVersion="codument.tech/v1alpha1" { kind = "component" behaviors = ["behavior://application-assembly/requirements/xnl-generic-consumers" "behavior://object-operation-contract/requirements/shared-definition"] } [
  <desc ?01KZWEXM8PNJ9MTVSFBTZ0X5DS>
  把 normalized ResourceNode 投影为通用 assembly 资源与统一对象 operation catalog，不暴露 parser-private 或 XML object shape。
  </?01KZWEXM8PNJ9MTVSFBTZ0X5DS>
  <runtime ?r>
  type Runtime = { readFile: ReadFile }
  </?r>
  <input ?i>
  type Input = readonly ResourceRecord[]
  </?i>
  <config ?c>
  type Config = readonly AuthoringModuleDescriptor[]
  </?c>
  <output ?o>
  type Output = ApplicationAssembly & ObjectOperationCatalog
  </?o>
  <pseudo { kind = "ctrl" } ?p>
  按 kind 选择 ResourceNode reader → 解析 contracts/materials/bindings/operations → 校验唯一 FQN 与 object binding closure → 组合 provenance
  </?p>
]>

<component #resource_consumers.resource_mapping apiVersion="codument.tech/v1alpha1" { kind = "component" behaviors = ["behavior://resource-mapping/requirements/xnl-mappings"] } [
  <desc ?01KZWEXM8PNJ9MTVSFBTZ0X5DT>
  解析 XNL mapping authority 并在任何写入前生成 collision-safe copy plan。
  </?01KZWEXM8PNJ9MTVSFBTZ0X5DT>
  <runtime ?r>
  type Runtime = { fs: FileSystem; xnlParser: XnlParser }
  </?r>
  <input ?i>
  type Input = string
  </?i>
  <config ?c>
  type Config = PlanResourceMappingsOptions
  </?c>
  <output ?o>
  type Output = ResourceMappings | ResourceMappingPlan
  </?o>
  <pseudo { kind = "ctrl" } ?p>
  解析 XNL → normalize mappings → 校验 roots/operations → preflight collisions → apply plan
  </?p>
]>

<object #resource_consumers.skill_capsule_provenance apiVersion="codument.tech/v1alpha1" {
  kind = "entity"
  fact_grade = "derived_projection_cache"
  single_writer = "modeling://domain/resource_consumers/skill_distribution_planner"
} [
  <desc ?>每个compiled SkillCapsule内固定路径的canonical provenance；绑定XNL source identity、生成协议和全部payload file digests。</?>
  <types ?provenance_types>
  interface SkillCapsuleIdentity {
    fqn: string
    name: string
    apiVersion: string
    version: string
  }
  interface SkillCapsuleProvenanceManifest {
    format: "halfcode.skill-provenance/v1"
    generatedBy: "halfcode.skill-distribution/v1"
    source: { fqn: string; apiVersion: string; version: string }
    payloadFiles: readonly { path: string; contentDigest: `sha256:${string}` }[]
  }
  </?provenance_types>
  <constraint ?canonical_path>每capsule恰有一个references/.halfcode/provenance.json；payloadFiles排除manifest自身并按UTF-16 code-unit path排序。</?canonical_path>
  <fact-source ?>FQN/name/apiVersion/version identity来自SkillCapsule XNL；YAML只保留呈现字段；payload digest来自planner冻结的canonical bytes；manifest是可重建投影且不反写XNL。</?>
]>

<component #resource_consumers.resource_dsl_consumer_skill apiVersion="codument.tech/v1alpha1" {
  kind = "component"
  behaviors = [
    "behavior://skill-capsule-distribution/requirements/canonical-resource-dsl-consumer-skill"
  ]
} [
  <desc ?>由canonical Resource DSL ResourcePackage与WikiPage resources编译的sys-halfcode-resource-dsl@1.0.0；SKILL只做渐进加载路由。</?>
  <runtime ?runtime>type Runtime = Readonly&lt;Record&lt;never, never&gt;&gt;</?runtime>
  <input ?authority>docs/resource-dsl/manifest.xnl、WikiPage descriptors、canonical Markdown/XNL examples与SkillCapsule XNL。</?authority>
  <config ?config>type Config = { rootSkillFqn: "Halfcode.ResourceDsl.Skill.System"; version: "1.0.0" }</?config>
  <output ?distribution>SkillCapsuleDistributionPlan中的一个root capsule，含SKILL.md、Resource DSL reference subtree和canonical provenance。</?distribution>
  <pseudo { kind = "dataflow" } ?dataflow>读取 canonical Resource DSL authority → 规划 sys-halfcode-resource-dsl capsule → 生成渐进加载入口、references 与 provenance。</?dataflow>
  <not-owned-here ?>Eidolon global init、安装路径、authoring/run operations、workflow kind semantics与registry publication。</?>
]>

<policy #resource_consumers.skill_provenance_authority apiVersion="codument.tech/v1alpha1" {
  kind = "policy"
  behaviors = [
    "behavior://skill-capsule-distribution/requirements/canonical-skill-provenance"
    "behavior://skill-capsule-distribution/requirements/consumer-skill-compatibility"
  ]
} [
  <pseudo { kind = "rule" } ?authority_rule>
  SkillCapsule XNL -> source FQN/name/apiVersion/version
  legacy descriptor without XNL name -> compatible YAML/FQN fallback only
  planner canonical payload bytes -> payload digests
  protocol constant -> generatedBy
  planner -> provenance manifest + capsule/closure digest
  applier -> exact provenance reconstruction before any target mutation
  host -> installation root and lifecycle policy only
  </?authority_rule>
]>
