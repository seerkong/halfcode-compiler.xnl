<Track #publish-normalized-resource-catalog-runtime apiVersion="codument.tech/v1alpha1" version="1" { status = "completed" goal = "将不含旧 CodePackage、只提供语义根、具名 Catalog 与受限目录 material 的 halfcode-compiler.xnl@0.2.8 发布并验证 registry identity" description = "提升不可变版本，执行全量及 packed installed-consumer 门禁，发布 npm 包并固化精确回读证据" question_mode = "decision-tree" question_severity = "auto" commit_mode = "manual" created_at = "2026-08-25T08:20:04.060Z" updated_at = "2026-08-25T08:27:40.979Z" modeling_base_commit = "7b08da0c024c6bb204778ccc9d7547648ab1a8fd" engineering_base_commit = "7b08da0c024c6bb204778ccc9d7547648ab1a8fd" } (
