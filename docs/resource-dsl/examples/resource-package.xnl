<ResourcePackage #demo.resource_workflow.authoring envelopeVersion="halfcode.resource-envelope/v1" specVersion=1 {
  lifecycle = "Active"
  description = "Demo authoring resource package"
} (
  <Catalogs [
    <Catalog #kind_definitions {
      kind = "KindDefinition"
      shape = "directory"
      root = "vfs://./KindDefinitions/"
      entry = "manifest.xnl"
    }>
    <Catalog #functions {
      kind = "Function"
      shape = "directory"
      root = "vfs://./Functions/"
      entry = "manifest.xnl"
    }>
  ]>
)>
