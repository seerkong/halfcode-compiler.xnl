<ResourceModule #demo.resource_workflow.module.core envelopeVersion="halfcode.resource-envelope/v1" specVersion=1 {
  lifecycle = "Active"
  description = "Nested manifest with a local catalog"
} (
  <Catalogs [
    <Catalog #module_notes { kind = "Note" shape = "single-file" root = "vfs://./Notes/" }>
  ]>
)>

