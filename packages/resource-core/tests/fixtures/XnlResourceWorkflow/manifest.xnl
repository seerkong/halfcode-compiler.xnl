<ResourcePackage #demo.resource_workflow.project envelopeVersion="halfcode.resource-envelope/v1" specVersion=1 {
  lifecycle = "Active"
  description = "XNL-native resource workflow fixture"
} (
  <Catalogs [
    <Catalog #kind_definitions { kind = "KindDefinition" shape = "directory" root = "vfs://./KindDefinitions/" entry = "manifest.xnl" }>
    <Catalog #root_notes { kind = "Note" shape = "single-file" root = "vfs://./Notes/" }>
    <Catalog #root_procedures { kind = "Procedure" shape = "directory" root = "vfs://./Procedures/" entry = "manifest.xnl" }>
    <Catalog #modules { kind = "ResourceModule" shape = "manifest" root = "vfs://./Modules/" entry = "manifest.xnl" }>
  ]>
)>

